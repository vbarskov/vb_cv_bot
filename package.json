{
  "name": "vb-cv-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Локальный помощник для cv_bot: очередь вакансий hh.ru, скоринг, письма и подготовка запусков.",
  "main": "./dsh/lib/index.js",
  "exports": {
    ".": "./dsh/lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dsh:mcp": "node dsh/install-mcp.mjs"
  }
}
